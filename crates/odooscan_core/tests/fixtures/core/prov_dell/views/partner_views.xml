<odoo>
    <record id="view_partner_dell" model="ir.ui.view">
        <field name="model" eval="'res.' + 'partner'"/>
        <field name="inherit_id" ref="base.view_partner_simple"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='notes']" position="after">
                <div id="dell_block"/>
            </xpath>
        </field>
    </record>
</odoo>
