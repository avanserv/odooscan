<odoo>
    <record id="view_partner_frame" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_simple"/>
        <field name="arch_base" type="xml">
            <xpath expr="//div[@id='notes']" position="before">
                <div id="frame_block"/>
            </xpath>
        </field>
    </record>
    <record id="view_partner_frame_note" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="view_partner_frame"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='veil_block']" position="inside">
                <span>Veil</span>
            </xpath>
        </field>
    </record>
</odoo>
