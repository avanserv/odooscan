<odoo>
    <record id="ticket_form_specs" model="ir.ui.view">
        <field name="name">modifier.ticket.form.specs</field>
        <field name="model">modifier.ticket</field>
        <field name="inherit_id" ref="ticket_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="readonly">
                    stat == 'done'
                </attribute>
                <attribute name="invisible" add="stat == 'done'" separator=" or "/>
                <attribute name="required">state ==</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="name" invisible="stat"/>
            </xpath>
            <field name="state" invisible="stat ==" position="before"/>
        </field>
    </record>

    <record id="ticket_form_subviews" model="ir.ui.view">
        <field name="name">modifier.ticket.form.subviews</field>
        <field name="model">modifier.ticket</field>
        <field name="inherit_id" ref="ticket_form"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="name" readonly="nowhere"/>
            </xpath>
            <xpath expr="//field[@name='quantity']" position="attributes">
                <attribute name="readonly">nowhere</attribute>
            </xpath>
            <xpath expr="//button[@name='unlink']" position="after">
                <field name="name" readonly="quantity"/>
            </xpath>
        </field>
    </record>

    <record id="ticket_summary" model="ir.ui.view">
        <field name="name">modifier.ticket.summary</field>
        <field name="model">modifier.ticket</field>
        <field name="arch" type="xml">
            <form>
                <field name="line_ids"/>
            </form>
        </field>
    </record>

    <record id="ticket_summary_lines" model="ir.ui.view">
        <field name="name">modifier.ticket.summary.lines</field>
        <field name="model">modifier.ticket</field>
        <field name="inherit_id" ref="ticket_summary"/>
        <field name="arch" type="xml">
            <field name="line_ids" position="inside">
                <list>
                    <field name="name" readonly="quantity"/>
                    <field name="name" readonly="nowhere"/>
                </list>
            </field>
        </field>
    </record>

    <record id="ticket_summary_anchored" model="ir.ui.view">
        <field name="name">modifier.ticket.summary.anchored</field>
        <field name="model">modifier.ticket</field>
        <field name="inherit_id" ref="ticket_summary"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="name" invisible="quantity"/>
            </xpath>
        </field>
    </record>

    <record id="ticket_digest" model="ir.ui.view">
        <field name="name">modifier.ticket.digest</field>
        <field name="model">modifier.ticket</field>
        <field name="arch" type="xml">
            <form>
                <field name="line_ids"/>
            </form>
        </field>
    </record>

    <record id="ticket_digest_lines" model="ir.ui.view">
        <field name="name">modifier.ticket.digest.lines</field>
        <field name="model">modifier.ticket</field>
        <field name="inherit_id" ref="ticket_digest"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']" position="inside">
                <form>
                    <field name="name" required="quantity"/>
                </form>
            </xpath>
        </field>
    </record>

    <record id="ticket_aside_extended" model="ir.ui.view">
        <field name="name">modifier.ticket.aside.extended</field>
        <field name="inherit_id" ref="ticket_aside"/>
        <field name="arch" type="xml">
            <group name="absent" position="inside">
                <field name="name" readonly="nowhere"/>
            </group>
        </field>
    </record>

    <record id="ticket_brief" model="ir.ui.view">
        <field name="name">modifier.ticket.brief</field>
        <field name="model">modifier.ticket</field>
        <field name="arch" type="xml">
            <form>
                <group name="heading"/>
                <field name="line_ids"/>
            </form>
        </field>
    </record>

    <record id="ticket_brief_anchored" model="ir.ui.view">
        <field name="name">modifier.ticket.brief.anchored</field>
        <field name="model">modifier.ticket</field>
        <field name="inherit_id" ref="ticket_brief"/>
        <field name="arch" type="xml">
            <group name="heading" position="inside">
                <field name="name" readonly="quantity"/>
            </group>
        </field>
    </record>

    <record id="ticket_nested" model="ir.ui.view">
        <field name="name">modifier.ticket.nested</field>
        <field name="model">modifier.ticket</field>
        <field name="arch" type="xml">
            <form>
                <field name="line_ids"/>
            </form>
        </field>
    </record>

    <record id="ticket_nested_lines" model="ir.ui.view">
        <field name="name">modifier.ticket.nested.lines</field>
        <field name="model">modifier.ticket</field>
        <field name="inherit_id" ref="ticket_nested"/>
        <field name="arch" type="xml">
            <field name="line_ids" position="inside">
                <list>
                    <field name="name" readonly="state"/>
                    <field name="name" readonly="parent.stat"/>
                    <field name="quantity" readonly="quantity"/>
                    <field name="name" readonly="parent.state"/>
                    <field name="state"/>
                    <field name="ticket_id" domain="[('stat', '=', 'new')]"/>
                    <button type="object" name="action_close"/>
                    <button type="object" name="action_split"/>
                    <field name="tag_ids">
                        <list>
                            <field name="name" invisible="color"/>
                            <field name="name" invisible="nowhere"/>
                        </list>
                    </field>
                </list>
            </field>
        </field>
    </record>

    <record id="ticket_placed" model="ir.ui.view">
        <field name="name">modifier.ticket.placed</field>
        <field name="model">modifier.ticket</field>
        <field name="arch" type="xml">
            <form>
                <field name="line_ids"/>
            </form>
        </field>
    </record>

    <record id="ticket_placed_lists" model="ir.ui.view">
        <field name="name">modifier.ticket.placed.lists</field>
        <field name="model">modifier.ticket</field>
        <field name="inherit_id" ref="ticket_placed"/>
        <field name="arch" type="xml">
            <field name="line_ids" position="after">
                <list>
                    <field name="name" invisible="state"/>
                </list>
            </field>
            <field name="line_ids" position="inside">
                <group>
                    <list>
                        <field name="name" invisible="state"/>
                    </list>
                </group>
            </field>
        </field>
    </record>

    <record id="ticket_tagged" model="ir.ui.view">
        <field name="name">modifier.ticket.tagged</field>
        <field name="model">modifier.ticket</field>
        <field name="arch" type="xml">
            <form>
                <field name="line_ids">
                    <list>
                        <field name="tag_ids"/>
                    </list>
                </field>
                <field name="tag_ids"/>
                <field name="name"/>
            </form>
        </field>
    </record>

    <record id="ticket_tagged_list" model="ir.ui.view">
        <field name="name">modifier.ticket.tagged.list</field>
        <field name="model">modifier.ticket</field>
        <field name="inherit_id" ref="ticket_tagged"/>
        <field name="arch" type="xml">
            <field name="tag_ids" position="inside">
                <list>
                    <field name="name" invisible="color"/>
                    <field name="color"/>
                    <field name="owner_id" domain="[('quantity', '=', 1)]"/>
                    <button type="object" name="action_tint"/>
                    <button type="object" name="action_fade"/>
                </list>
            </field>
            <field name="name" position="after">
                <field name="line_ids">
                    <list>
                        <field name="nowhere"/>
                    </list>
                </field>
            </field>
        </field>
    </record>

    <record id="ticket_hooked" model="ir.ui.view">
        <field name="name">modifier.ticket.hooked</field>
        <field name="model">modifier.ticket</field>
        <field name="arch" type="xml">
            <form>
                <field name="hook_ids"/>
            </form>
        </field>
    </record>

    <record id="ticket_hooked_list" model="ir.ui.view">
        <field name="name">modifier.ticket.hooked.list</field>
        <field name="model">modifier.ticket</field>
        <field name="inherit_id" ref="ticket_hooked"/>
        <field name="arch" type="xml">
            <field name="hook_ids" position="inside">
                <list>
                    <field name="name" invisible="hooked"/>
                </list>
            </field>
            <field name="hook_ids" position="after">
                <field name="name" invisible="hooked"/>
            </field>
        </field>
    </record>

    <record id="ticket_bound" model="ir.ui.view">
        <field name="name">modifier.ticket.bound</field>
        <field name="model">modifier.ticket</field>
        <field name="arch" type="xml">
            <form>
                <field name="bound_ids"/>
            </form>
        </field>
    </record>

    <record id="ticket_bound_list" model="ir.ui.view">
        <field name="name">modifier.ticket.bound.list</field>
        <field name="model">modifier.ticket</field>
        <field name="inherit_id" ref="ticket_bound"/>
        <field name="arch" type="xml">
            <field name="bound_ids" position="inside">
                <list>
                    <field name="name" invisible="bounded"/>
                </list>
            </field>
            <field name="bound_ids" position="after">
                <field name="name" invisible="bounded"/>
            </field>
        </field>
    </record>

    <record id="ticket_loose" model="ir.ui.view">
        <field name="name">modifier.ticket.loose</field>
        <field name="model">modifier.ticket</field>
        <field name="arch" type="xml">
            <form>
                <field name="loose_ids"/>
            </form>
        </field>
    </record>

    <record id="ticket_loose_list" model="ir.ui.view">
        <field name="name">modifier.ticket.loose.list</field>
        <field name="model">modifier.ticket</field>
        <field name="inherit_id" ref="ticket_loose"/>
        <field name="arch" type="xml">
            <field name="loose_ids" position="inside">
                <list>
                    <field name="name" invisible="nowhere"/>
                    <field name="nowhere"/>
                    <button type="object" name="action_nowhere"/>
                </list>
            </field>
        </field>
    </record>

    <record id="ticket_orphan_list" model="ir.ui.view">
        <field name="name">modifier.ticket.orphan.list</field>
        <field name="model">modifier.ticket</field>
        <field name="inherit_id" ref="ticket_missing"/>
        <field name="arch" type="xml">
            <field name="line_ids" position="inside">
                <list>
                    <field name="state"/>
                </list>
            </field>
        </field>
    </record>

    <record id="ticket_flags" model="ir.ui.view">
        <field name="name">modifier.ticket.flags</field>
        <field name="model">modifier.ticket</field>
        <field name="arch" type="xml">
            <form>
                <field name="state" readonly="name"/>
                <field name="name"/>
                <field name="tag_ids"/>
                <field name="tag_ids" readonly="name"/>
                <field name="line_ids"/>
            </form>
        </field>
    </record>

    <record id="ticket_flags_added" model="ir.ui.view">
        <field name="name">modifier.ticket.flags.added</field>
        <field name="model">modifier.ticket</field>
        <field name="inherit_id" ref="ticket_flags"/>
        <field name="arch" type="xml">
            <field name="state" position="attributes">
                <attribute name="readonly"> </attribute>
                <attribute name="readonly" add="true" separator="or"/>
                <attribute name="invisible">
                    true
                </attribute>
                <attribute name="required">true</attribute>
                <attribute name="required">
                    0
                </attribute>
                <attribute name="required">
                    True
                </attribute>
                <attribute name="readonly" add="1" separator="or"/>
            </field>
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="readonly" add="false" separator=" and "/>
            </xpath>
            <field name="name" position="attributes">
                <attribute name="readonly" add="true" separator="or"/>
            </field>
            <field name="tag_ids" position="attributes">
                <attribute name="readonly" add="true" separator="or"/>
            </field>
            <xpath expr="//field[@name='state']/.." position="attributes">
                <attribute name="readonly" add="true" separator="or"/>
            </xpath>
            <field name="line_ids" position="attributes">
                <attribute name="name">bound_ids</attribute>
            </field>
            <field name="bound_ids" position="attributes">
                <attribute name="readonly" add="true" separator="or"/>
            </field>
        </field>
    </record>

    <record id="ticket_flags_middle" model="ir.ui.view">
        <field name="name">modifier.ticket.flags.middle</field>
        <field name="model">modifier.ticket</field>
        <field name="inherit_id" ref="ticket_flags"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="hook_ids" readonly="name"/>
            </field>
        </field>
    </record>

    <record id="ticket_flags_stacked" model="ir.ui.view">
        <field name="name">modifier.ticket.flags.stacked</field>
        <field name="model">modifier.ticket</field>
        <field name="inherit_id" ref="ticket_flags_middle"/>
        <field name="arch" type="xml">
            <field name="state" position="attributes">
                <attribute name="readonly" add="true" separator="or"/>
            </field>
            <field name="hook_ids" position="attributes">
                <attribute name="readonly" add="true" separator="or"/>
            </field>
        </field>
    </record>

    <record id="ticket_stray_add" model="ir.ui.view">
        <field name="name">modifier.ticket.stray.add</field>
        <field name="model">modifier.ticket</field>
        <field name="arch" type="xml">
            <form>
                <group name="stray" readonly="name">
                    <attribute name="readonly" add="true" separator="or"/>
                </group>
                <field name="name"/>
            </form>
        </field>
    </record>

    <record id="ticket_emptied" model="ir.ui.view">
        <field name="name">modifier.ticket.emptied</field>
        <field name="model">modifier.ticket</field>
        <field name="arch" type="xml">
            <form>
                <field name="state" readonly="name" invisible="name" required="name" column_invisible="name"/>
                <field name="name"/>
            </form>
        </field>
    </record>

    <record id="ticket_emptied_first" model="ir.ui.view">
        <field name="name">modifier.ticket.emptied.first</field>
        <field name="model">modifier.ticket</field>
        <field name="inherit_id" ref="ticket_emptied"/>
        <field name="arch" type="xml">
            <field name="state" position="attributes">
                <attribute name="readonly"/>
                <attribute name="invisible" remove="name" separator="or"/>
            </field>
        </field>
    </record>

    <record id="ticket_emptied_added" model="ir.ui.view">
        <field name="name">modifier.ticket.emptied.added</field>
        <field name="model">modifier.ticket</field>
        <field name="inherit_id" ref="ticket_emptied"/>
        <field name="arch" type="xml">
            <field name="state" position="attributes">
                <attribute name="readonly" add="true" separator="or"/>
                <attribute name="invisible" add="true" separator="or"/>
                <attribute name="invisible" add="true" remove="name" separator="or"/>
                <attribute name="required"></attribute>
                <attribute name="required" add="true" separator="or"/>
                <attribute name="column_invisible" remove="name" separator="or"/>
                <attribute name="column_invisible" add="true" separator="or"/>
            </field>
        </field>
    </record>

    <record id="ticket_cleared" model="ir.ui.view">
        <field name="name">modifier.ticket.cleared</field>
        <field name="model">modifier.ticket</field>
        <field name="arch" type="xml">
            <form>
                <group name="box" id="box_anchor" invisible="name">
                    <field name="state" readonly="name" required="name"/>
                    <field name="name"/>
                </group>
            </form>
        </field>
    </record>

    <record id="ticket_cleared_first" model="ir.ui.view">
        <field name="name">modifier.ticket.cleared.first</field>
        <field name="model">modifier.ticket</field>
        <field name="inherit_id" ref="ticket_cleared"/>
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="readonly"/>
            </field>
            <xpath expr="//group[@name='box']/field[1]" position="attributes">
                <attribute name="required"/>
            </xpath>
            <xpath expr="//group[@id='box_anchor']" position="attributes">
                <attribute name="invisible"/>
            </xpath>
        </field>
    </record>

    <record id="ticket_cleared_added" model="ir.ui.view">
        <field name="name">modifier.ticket.cleared.added</field>
        <field name="model">modifier.ticket</field>
        <field name="inherit_id" ref="ticket_cleared"/>
        <field name="arch" type="xml">
            <field name="state" position="attributes">
                <attribute name="readonly" add="true" separator="or"/>
                <attribute name="required" add="true" separator="or"/>
            </field>
            <group name="box" position="attributes">
                <attribute name="invisible" add="true" separator="or"/>
            </group>
        </field>
    </record>
</odoo>
