<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="template_names_read.Note">
        <t t-call="template_names_read.Absent"/>
    </t>
    <t t-inherit="template_names_read.Absent" t-inherit-mode="extension">
        <xpath expr="//span" position="after">
            <span>Note</span>
        </xpath>
    </t>
    <t t-inherit="web.FormController" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_smudge_panel')]" position="inside">
            <span>Panel</span>
        </xpath>
    </t>
</templates>
