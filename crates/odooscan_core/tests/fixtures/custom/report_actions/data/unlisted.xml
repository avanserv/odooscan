<odoo>
    <record id="name_unlisted" model="ir.actions.report">
        <field name="name">name_unlisted</field>
        <field name="model">res.partner</field>
        <field name="report_name">report_actions.absent_unlisted</field>
    </record>

    <record id="file_unlisted" model="ir.actions.report">
        <field name="name">file_unlisted</field>
        <field name="model">res.partner</field>
        <field name="report_name">report_actions.sheet</field>
        <field name="print_report_name">name = 11</field>
    </record>

    <record id="unlisted_replaces_name" model="ir.actions.report">
        <field name="report_name">report_actions.sheet</field>
    </record>

    <record id="unlisted_replaces_file" model="ir.actions.report">
        <field name="print_report_name">object.name</field>
    </record>

    <template id="unlisted_sheet" key="report_actions.unlisted_sheet_key">
        <div/>
    </template>
</odoo>
