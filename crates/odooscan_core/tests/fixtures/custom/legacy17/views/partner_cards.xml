<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="partner_kanban_cards" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="kanban-box">
                        <div><field name="name"/></div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="partner_form_chatter" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form>
                <field name="name"/>
                <div class="oe_chatter"/>
            </form>
        </field>
    </record>

    <record id="action_company_tree" model="ir.actions.act_window">
        <field name="name">action_company_tree</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">tree,gantt</field>
    </record>
</odoo>
