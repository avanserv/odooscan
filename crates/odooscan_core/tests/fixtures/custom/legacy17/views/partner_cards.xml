<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="partner_kanban_cards" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="kanban-box">
                        <div><field name="name"/></div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="partner_form_chatter" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form>
                <field name="name"/>
                <div class="oe_chatter"/>
            </form>
        </field>
    </record>
</odoo>
