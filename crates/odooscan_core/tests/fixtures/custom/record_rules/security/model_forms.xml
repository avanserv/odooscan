<odoo>
    <record id="rule_model_ref" model="ir.rule">
        <field name="model_id" ref="model_rule_ticket"/>
        <field name="domain_force">[('no_model_ref', '=', 1)]</field>
    </record>
    <record id="rule_model_dotted" model="ir.rule">
        <field name="model_id" ref="record_rules.model_rule_ticket"/>
        <field name="domain_force">[('no_model_dotted', '=', 1)]</field>
    </record>
    <record id="rule_model_eval" model="ir.rule">
        <field name="model_id" eval="ref('model_rule_ticket')"/>
        <field name="domain_force">[('no_model_eval', '=', 1)]</field>
    </record>
    <record id="rule_model_search" model="ir.rule">
        <field name="model_id" search="[('model', '=', 'rule.ticket')]"/>
        <field name="domain_force">[('no_model_search', '=', 1)]</field>
    </record>

    <record id="rule_model_other_eval" model="ir.rule">
        <field name="model_id" eval="ref('model_rule_ticket') or False"/>
        <field name="domain_force">[('no_other_eval', '=', 1)]</field>
    </record>
    <record id="rule_model_other_field" model="ir.rule">
        <field name="model_id" search="[('name', '=', 'rule.ticket')]"/>
        <field name="domain_force">[('no_other_field', '=', 1)]</field>
    </record>
    <record id="rule_model_other_operator" model="ir.rule">
        <field name="model_id" search="[('model', '!=', 'rule.ticket')]"/>
        <field name="domain_force">[('no_other_operator', '=', 1)]</field>
    </record>
    <record id="rule_model_two_terms" model="ir.rule">
        <field name="model_id" search="[('model', '=', 'rule.ticket'), ('name', '=', 'a')]"/>
        <field name="domain_force">[('no_two_terms', '=', 1)]</field>
    </record>
    <record id="rule_model_use" model="ir.rule">
        <field name="model_id" search="[('model', '=', 'rule.ticket')]" use="id"/>
        <field name="domain_force">[('no_use', '=', 1)]</field>
    </record>
    <record id="rule_model_comodel" model="ir.rule">
        <field name="model_id" search="[('model', '=', 'rule.ticket')]" model="ir.ui.view"/>
        <field name="domain_force">[('no_comodel', '=', 1)]</field>
    </record>
    <record id="rule_model_empty" model="ir.rule">
        <field name="model_id"/>
        <field name="domain_force">[('no_empty', '=', 1)]</field>
    </record>

    <record id="manual_model" model="ir.model">
        <field name="model">rule.manual</field>
    </record>
    <record id="rule_model_data_id" model="ir.rule">
        <field name="model_id" ref="manual_model"/>
        <field name="domain_force">[('no_data_id', '=', 1)]</field>
    </record>

    <record id="rule_ticket_rules" model="ir.model">
        <field name="model">rule.ticket</field>
        <field name="rule_ids">
            <record id="rule_model_nested" model="ir.rule">
                <field name="model_id" ref="model_rule_ticket"/>
                <field name="domain_force">[('no_nested', '=', 1)]</field>
            </record>
        </field>
    </record>
</odoo>
