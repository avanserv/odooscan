<odoo>
    <record id="rule_updated" model="ir.rule">
        <field name="model_id" ref="model_rule_ticket"/>
        <field name="domain_force">[('name', '=', 'a')]</field>
    </record>
    <record id="rule_replaced" model="ir.rule">
        <field name="model_id" ref="model_rule_ticket"/>
        <field name="domain_force">[('no_replaced', '=', 1)]</field>
    </record>
    <record id="rule_switched_off" model="ir.rule">
        <field name="model_id" ref="model_rule_ticket"/>
        <field name="domain_force">[('no_switched_off_later', '=', 1)]</field>
    </record>
    <record id="rule_scoped" model="ir.rule">
        <field name="model_id" ref="model_rule_ticket"/>
        <field name="domain_force">[('name', '=', 'a')]</field>
    </record>
    <record id="rule_opaque_update" model="ir.rule">
        <field name="model_id" ref="model_rule_ticket"/>
    </record>
    <record id="rule_held_off" model="ir.rule">
        <field name="model_id" ref="model_rule_ticket"/>
        <field name="active" eval="False"/>
    </record>
    <record id="rule_supplied" model="ir.rule">
        <field name="domain_force">[('no_supplied', '=', 1)]</field>
    </record>
    <record id="rule_moved" model="ir.rule">
        <field name="model_id" ref="model_rule_ticket"/>
        <field name="domain_force">[('name', '=', 'a')]</field>
    </record>
</odoo>
