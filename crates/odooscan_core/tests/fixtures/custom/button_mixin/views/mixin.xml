<odoo>
    <record id="plain_form" model="ir.ui.view">
        <field name="name">button.plain.form</field>
        <field name="model">button.plain</field>
        <field name="arch" type="xml">
            <form>
                <button type="object" name="action_hook" invisible="hooked"/>
            </form>
        </field>
    </record>

    <record id="ghosted_form" model="ir.ui.view">
        <field name="name">button.ghosted.form</field>
        <field name="model">button.ghosted</field>
        <field name="arch" type="xml">
            <form>
                <button type="object" name="action_ghost" invisible="ghosted"/>
            </form>
        </field>
    </record>

    <function model="button.plain" name="action_hook"/>
    <function model="button.ghosted" name="action_ghost"/>

    <record id="action_plain" model="ir.actions.act_window">
        <field name="name">action_plain</field>
        <field name="res_model">button.plain</field>
        <field name="view_mode">gantt</field>
    </record>

    <record id="action_ghosted" model="ir.actions.act_window">
        <field name="name">action_ghosted</field>
        <field name="res_model">button.ghosted</field>
        <field name="view_mode">gantt</field>
    </record>
</odoo>
