<odoo>
    <record id="action_kept_by_false" model="ir.actions.act_window">
        <field name="name">action_kept_by_false</field>
        <field name="res_model">window.cleared.old</field>
        <field name="view_mode">gantt</field>
    </record>

    <record id="row_kept_by_false" model="ir.actions.act_window.view">
        <field name="view_mode">gantt</field>
        <field name="view_id" search="[('name', '=', 'window.shown.gantt')]"/>
        <field name="act_window_id" ref="action_kept_by_false"/>
    </record>

    <record id="action_kept_by_false" model="ir.actions.act_window">
        <field name="view_ids" eval="False"/>
    </record>

    <record id="action_dropped_by_clear" model="ir.actions.act_window">
        <field name="name">action_dropped_by_clear</field>
        <field name="res_model">window.cleared.old</field>
        <field name="view_mode">gantt</field>
    </record>

    <record id="row_dropped_by_clear" model="ir.actions.act_window.view">
        <field name="view_mode">gantt</field>
        <field name="view_id" search="[('name', '=', 'window.shown.gantt')]"/>
        <field name="act_window_id" ref="action_dropped_by_clear"/>
    </record>

    <record id="action_dropped_by_clear" model="ir.actions.act_window">
        <field name="view_ids" eval="[(5, 0, 0)]"/>
    </record>
</odoo>
