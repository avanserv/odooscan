<odoo>
    <record id="layout_banner" model="ir.ui.view">
        <field name="inherit_id" ref="web.layout"/>
        <field name="arch" type="xml">
            <xpath expr="//body/div[@id='shell']" position="inside">
                <div class="banner"/>
            </xpath>
        </field>
    </record>

    <record id="layout_footer" model="ir.ui.view">
        <field name="inherit_id" ref="web.no_such_layout"/>
        <field name="arch" type="xml">
            <xpath expr="//body" position="inside">
                <div class="footer"/>
            </xpath>
        </field>
    </record>

    <record id="view_partner_color" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form>
                <field name="web_color"/>
                <field name="theme_id"/>
            </form>
        </field>
    </record>

    <record id="canvas_frame" model="ir.ui.view">
        <field name="inherit_id" ref="web_canvas.canvas"/>
        <field name="arch" type="xml">
            <xpath expr="//body/div[@id='easel']" position="inside">
                <div class="frame"/>
            </xpath>
        </field>
    </record>

    <record id="flags_badge" model="ir.ui.view">
        <field name="inherit_id" ref="web_flags.flags"/>
        <field name="arch" type="xml">
            <xpath expr="//body/div[@id='pennant']" position="inside">
                <div class="badge"/>
            </xpath>
        </field>
    </record>

    <record id="digest_footer" model="ir.ui.view">
        <field name="inherit_id" ref="mail_digest.digest"/>
        <field name="arch" type="xml">
            <xpath expr="//body" position="inside">
                <div class="footer"/>
            </xpath>
        </field>
    </record>

    <record id="pinboard_header" model="ir.ui.view">
        <field name="inherit_id" ref="web_pinboard.pinboard"/>
        <field name="arch" type="xml">
            <xpath expr="//body" position="inside">
                <div class="header"/>
            </xpath>
        </field>
    </record>

    <record id="tack_header" model="ir.ui.view">
        <field name="inherit_id" ref="web_tack.tack"/>
        <field name="arch" type="xml">
            <xpath expr="//body" position="inside">
                <div class="tacks-header"/>
            </xpath>
        </field>
    </record>

    <record id="thumbtack_header" model="ir.ui.view">
        <field name="inherit_id" ref="web_thumbtack.thumbtack"/>
        <field name="arch" type="xml">
            <xpath expr="//body" position="inside">
                <div class="thumbtacks-header"/>
            </xpath>
        </field>
    </record>

    <record id="sticker_header" model="ir.ui.view">
        <field name="inherit_id" ref="web_sticker.sticker"/>
        <field name="arch" type="xml">
            <xpath expr="//body" position="inside">
                <div class="stickers-header"/>
            </xpath>
        </field>
    </record>

    <record id="easel_header" model="ir.ui.view">
        <field name="inherit_id" ref="web_easel.easel"/>
        <field name="arch" type="xml">
            <xpath expr="//body" position="inside">
                <div class="easel-header"/>
            </xpath>
        </field>
    </record>

    <record id="sketch_header" model="ir.ui.view">
        <field name="inherit_id" ref="web_sketch.sketch"/>
        <field name="arch" type="xml">
            <xpath expr="//body" position="inside">
                <div class="sketch-header"/>
            </xpath>
        </field>
    </record>

    <record id="ribbon_header" model="ir.ui.view">
        <field name="inherit_id" ref="web_ribbon.ribbon"/>
        <field name="arch" type="xml">
            <xpath expr="//body" position="inside">
                <div class="ribbon-header"/>
            </xpath>
        </field>
    </record>

    <record id="layout_sidebar" model="ir.ui.view">
        <field name="inherit_id" ref="web.layout"/>
        <field name="arch" type="xml">
            <xpath expr="//body/div[@id='sidebar']" position="inside">
                <div class="menu"/>
            </xpath>
        </field>
    </record>

    <record id="partner_teal" model="res.partner">
        <field name="name">Teal Studio</field>
        <field name="web_color">teal</field>
    </record>
</odoo>
