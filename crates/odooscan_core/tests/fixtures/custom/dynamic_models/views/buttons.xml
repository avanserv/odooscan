<odoo>
    <record id="generated_user_form" model="ir.ui.view">
        <field name="name">bad.generated.user.form</field>
        <field name="model">bad.generated.user</field>
        <field name="arch" type="xml">
            <form>
                <button type="object" name="action_generated" invisible="generated"/>
            </form>
        </field>
    </record>

    <function model="bad.generated.user" name="action_generated"/>

    <record id="action_partners" model="ir.actions.act_window">
        <field name="name">action_partners</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">gantt</field>
    </record>

    <record id="rule_generated" model="ir.rule">
        <field name="model_id" ref="model_bad_generated_user"/>
        <field name="domain_force">[('no_dynamic', '=', 1)]</field>
    </record>
</odoo>
