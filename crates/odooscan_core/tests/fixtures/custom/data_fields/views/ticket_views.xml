<odoo>
    <record id="view_ticket_form" model="ir.ui.view">
        <field name="name">ticket form</field>
        <field name="model">data.ticket</field>
        <field name="arch" type="xml">
            <form>
                <field name="x_by_run"/>
                <field name="x_flag"/>
                <field name="x_by_eval"/>
                <field name="x_by_search"/>
                <field name="x_by_name"/>
                <field name="x_from_csv"/>
                <field name="x_late"/>
                <field name="x_line_ids">
                    <list>
                        <field name="name"/>
                        <field name="no_line_field"/>
                        <button type="object" name="no_line_method"/>
                    </list>
                </field>
            </form>
        </field>
    </record>
    <record id="view_ticket_copy_form" model="ir.ui.view">
        <field name="name">ticket copy form</field>
        <field name="model">data.ticket.copy</field>
        <field name="arch" type="xml">
            <form>
                <field name="x_text"/>
            </form>
        </field>
    </record>
    <record id="action_ticket" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">data.ticket</field>
        <field name="view_mode">list,form,calendar</field>
    </record>
</odoo>
