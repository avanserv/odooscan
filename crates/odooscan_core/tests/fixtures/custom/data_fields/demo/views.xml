<odoo>
    <record id="view_partner_demo_form" model="ir.ui.view">
        <field name="name">partner demo form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form>
                <field name="x_demo"/>
                <field name="name" invisible="x_demo"/>
            </form>
        </field>
    </record>
    <record id="partner_demo" model="res.partner">
        <field name="name">Demo</field>
        <field name="x_demo" eval="True"/>
    </record>
    <record id="rule_demo_x_demo" model="ir.rule">
        <field name="name">by a field of a demo record, in demo</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[('x_demo', '=', True)]</field>
    </record>
</odoo>
