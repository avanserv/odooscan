<odoo>
    <record id="ghost_one" model="ghost.thing">
        <field name="tag">ghost</field>
    </record>
    <record id="refs_one" model="refs.thing">
        <field name="tag">refs</field>
    </record>
    <!-- No indexed class introduces ghost.thing, so its table may be that of res.partner. -->
    <record id="holder_ghost" model="refs.holder">
        <field name="partner_id" ref="ghost_one"/>
    </record>
    <record id="holder_refs" model="refs.holder">
        <field name="partner_id" ref="refs_one"/>
    </record>
    <record id="lantern_one" model="ghost.lantern">
        <field name="wick">lit</field>
    </record>
    <record id="refs_kid_form" model="ir.ui.view">
        <field name="name">refs.kid.form</field>
        <field name="model">refs.kid</field>
        <field name="arch" type="xml">
            <form>
                <field name="wick"/>
            </form>
        </field>
    </record>
    <record id="refs_cub_form" model="ir.ui.view">
        <field name="name">refs.cub.form</field>
        <field name="model">refs.cub</field>
        <field name="arch" type="xml">
            <form>
                <field name="wick"/>
            </form>
        </field>
    </record>
    <record id="refs_kid_wick" model="refs.kid">
        <field name="wick">lit</field>
    </record>
    <record id="refs_child_wick" model="refs.child">
        <field name="wick">lit</field>
    </record>
    <record id="refs_grand_wick" model="refs.grand">
        <field name="wick">lit</field>
    </record>
    <record id="refs_cub_wick" model="refs.cub">
        <field name="wick">lit</field>
    </record>
    <record id="refs_heir_wick" model="refs.heir">
        <field name="wick">lit</field>
    </record>
</odoo>
