<odoo>
    <function model="res.partner" name="_get_xml_ids"/>
    <function model="res.partner" name="_get_xml_id"/>

    <record id="cron_aliases" model="ir.cron">
        <field name="name">cron_aliases</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="code">model._get_xml_ids()</field>
    </record>

    <record id="cron_misspelled" model="ir.cron">
        <field name="name">cron_misspelled</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="code">model._get_xml_id()</field>
    </record>
</odoo>
