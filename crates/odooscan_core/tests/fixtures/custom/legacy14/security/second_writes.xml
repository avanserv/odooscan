<odoo>
    <record id="rule_ledger_replaced" model="ir.rule">
        <field name="domain_force">[('name', '=', 'a')]</field>
    </record>
    <record id="rule_ledger_deactivated" model="ir.rule">
        <field name="active" eval="False"/>
    </record>
    <record id="rule_ledger_supplied" model="ir.rule">
        <field name="model_id" ref="model_legacy_ledger"/>
    </record>
</odoo>
