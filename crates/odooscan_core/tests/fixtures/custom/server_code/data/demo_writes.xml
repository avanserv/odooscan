<odoo>
    <record id="demo_fixes_code" model="ir.cron">
        <field name="name">demo_fixes_code</field>
        <field name="model_id" ref="model_server_job"/>
        <field name="code">model._nope_demo_fixes()</field>
    </record>

    <record id="demo_changes_state" model="ir.actions.server">
        <field name="name">demo_changes_state</field>
        <field name="model_id" ref="model_server_job"/>
        <field name="state">code</field>
        <field name="code">model._nope_demo_state()</field>
    </record>

    <record id="demo_changes_model" model="ir.cron">
        <field name="name">demo_changes_model</field>
        <field name="model_id" ref="model_server_job"/>
        <field name="code">model.action_pin()</field>
    </record>

    <record id="demo_breaks_code" model="ir.cron">
        <field name="name">demo_breaks_code</field>
        <field name="model_id" ref="model_server_job"/>
        <field name="code">model._run_daily()</field>
    </record>
</odoo>
