<odoo>
    <template id="assets_frontend" inherit_id="web.assets_frontend">
        <xpath expr="." position="inside">
            <script type="text/javascript" src="/legacy16/static/src/js/widget.js"/>
        </xpath>
    </template>

    <template id="layout" inherit_id="web.layout">
        <xpath expr="//div[@id='shell']" position="inside">
            <div class="o_legacy_banner"/>
        </xpath>
    </template>

    <record id="asset_widget_templates" model="ir.asset">
        <field name="name">Legacy widget templates</field>
        <field name="bundle">web.assets_qweb</field>
        <field name="path">legacy16/static/src/xml/widget.xml</field>
    </record>
</odoo>
