<odoo>
    <record id="view_partner_tree" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" attrs="{'invisible': [('parent_id', '=', False)]}"/>
                <field name="name" invisible="parent_id ==" readonly="nickname == 1"/>
            </tree>
        </field>
    </record>

    <record id="view_gauge_form" model="ir.ui.view">
        <field name="model">legacy.gauge</field>
        <field name="arch" type="xml">
            <form>
                <group invisible="level == 0"/>
            </form>
        </field>
    </record>

    <record id="view_partner_tree_flagged" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="view_partner_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="readonly"> </attribute>
                <attribute name="invisible" add="true" separator=" or "/>
            </field>
        </field>
    </record>
</odoo>
