<odoo>
    <function model="res.partner" name="create_workflow"/>
    <function model="res.partner" name="import_data"/>
    <function model="res.partner" name="create_workflo"/>

    <record id="action_signal" model="ir.actions.server">
        <field name="name">action_signal</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model.signal_workflow("go")</field>
    </record>

    <record id="action_callable_attrs" model="ir.actions.server">
        <field name="name">action_callable_attrs</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model.env(user=1)
model.pool('res.partner')
model._nope_after_attrs()</field>
    </record>

    <record id="action_no_state" model="ir.actions.server">
        <field name="name">action_no_state</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="code">model._nope_default_code()</field>
    </record>

    <record id="action_written_state" model="ir.actions.server">
        <field name="name">action_written_state</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">object_write</field>
        <field name="code">model._nope_written_state()</field>
    </record>

    <record id="base.action_elsewhere" model="ir.actions.server">
        <field name="name">action_elsewhere</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="code">model._nope_elsewhere()</field>
    </record>

    <record id="syntax_code_state" model="ir.actions.server">
        <field name="name">syntax_code_state</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model.write({</field>
    </record>

    <record id="syntax_no_state" model="ir.actions.server">
        <field name="name">syntax_no_state</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="code">if</field>
    </record>

    <record id="syntax_written_state" model="ir.actions.server">
        <field name="name">syntax_written_state</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">object_write</field>
        <field name="code">if</field>
    </record>

    <record id="base.syntax_elsewhere" model="ir.actions.server">
        <field name="name">syntax_elsewhere</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="code">if</field>
    </record>

    <record id="syntax_cron" model="ir.cron">
        <field name="name">syntax_cron</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="code">if</field>
    </record>

    <record id="cron_never_runs" model="ir.cron">
        <field name="name">cron_never_runs</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="code">model._nope_cron_never_runs()</field>
        <field name="no_such_field">1</field>
    </record>

    <record id="rewritten_code" model="ir.actions.server">
        <field name="name">rewritten_code</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">if</field>
    </record>

    <record id="rewritten_state" model="ir.actions.server">
        <field name="name">rewritten_state</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">if</field>
    </record>
</odoo>
