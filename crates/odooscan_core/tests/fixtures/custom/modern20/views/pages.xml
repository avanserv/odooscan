<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="lamp_page">
        <div class="lamp">
            <span t-esc="lamp.name"/>
            <p t-raw="lamp.note"/>
        </div>
    </template>

    <record id="lamp_page_ported" model="ir.ui.view">
        <field name="inherit_id" ref="lamp_page"/>
        <field name="arch" type="xml">
            <data>
                <span t-esc="lamp.name" position="replace">
                    <span t-out="lamp.name"/>
                </span>
                <xpath expr="//p" position="after">
                    <em t-esc="lamp.code"/>
                </xpath>
            </data>
        </field>
    </record>

    <record id="partner_kanban_cards" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <span t-esc="record.name.value"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <template id="lamp_badge">
        <b class="lamp_badge" t-esc="lamp.code"/>
    </template>

    <template id="lamp_label">
        <span class="lamp_label" t-esc="lamp.name"/>
    </template>

    <template id="lamp_label_coded" inherit_id="lamp_label">
        <xpath expr="//span[hasclass('lamp_label')]" position="attributes">
            <attribute name="t-esc">lamp.code</attribute>
        </xpath>
    </template>

    <template id="lamp_tag">
        <i class="lamp_tag" t-esc="lamp.code"/>
    </template>

    <template id="lamp_tag_named" inherit_id="lamp_tag">
        <xpath expr="//i[hasclass('lamp_tag')]" position="attributes">
            <attribute name="t-out" add="lamp.name" separator=" or "/>
        </xpath>
    </template>

    <template id="lamp_title">
        <h1 class="lamp_title" t-esc="lamp.name"/>
    </template>

    <template id="lamp_title_coded" inherit_id="lamp_title">
        <xpath expr="//h1[hasclass('lamp_title')]" position="attributes">
            <attribute name="t-out">lamp.code</attribute>
        </xpath>
    </template>
</odoo>
