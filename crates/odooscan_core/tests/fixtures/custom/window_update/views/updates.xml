<odoo>
    <record id="window_actions.action_generated" model="ir.actions.act_window">
        <field name="view_mode">list,form,gantt</field>
    </record>

    <record id="window_actions.action_no_date" model="ir.actions.act_window">
        <field name="view_mode">list</field>
    </record>

    <record id="window_actions.action_eval_model" model="ir.actions.act_window">
        <field name="view_mode">gantt</field>
    </record>

    <record id="window_ghost.action_gone" model="ir.actions.act_window">
        <field name="view_mode">gantt</field>
    </record>

    <record id="action_model_replaced" model="ir.actions.act_window">
        <field name="res_model" eval="'window.plain'"/>
    </record>

    <record id="action_mode_replaced" model="ir.actions.act_window">
        <field name="name">action_mode_replaced</field>
        <field name="res_model">window.plain</field>
        <field name="view_mode">gantt</field>
    </record>

    <record id="action_mode_grown" model="ir.actions.act_window">
        <field name="name">action_mode_grown</field>
        <field name="res_model">window.plain</field>
        <field name="view_mode">list</field>
    </record>

    <record id="action_mode_hidden" model="ir.actions.act_window">
        <field name="name">action_mode_hidden</field>
        <field name="res_model">window.plain</field>
        <field name="view_mode">gantt</field>
    </record>

    <record id="action_moved" model="ir.actions.act_window">
        <field name="name">action_moved</field>
        <field name="res_model">window.plain</field>
    </record>

    <record id="action_own" model="ir.actions.act_window">
        <field name="name">action_own</field>
        <field name="res_model">window.plain</field>
    </record>

    <record id="window_actions.action_own_list" model="ir.actions.act_window">
        <field name="view_mode">gantt</field>
    </record>

    <record id="action_row_demo_taken" model="ir.actions.act_window">
        <field name="name">action_row_demo_taken</field>
        <field name="res_model">window.plain</field>
        <field name="view_mode">gantt</field>
    </record>

    <record id="row_demo_taken" model="ir.actions.act_window.view">
        <field name="view_mode">gantt</field>
        <field name="view_id" ref="window_actions.view_shown_gantt"/>
        <field name="act_window_id" ref="action_row_demo_taken"/>
    </record>

    <record id="window_actions.row_unordered" model="ir.actions.act_window.view">
        <field name="view_mode">gantt</field>
        <field name="view_id" ref="window_actions.view_shown_gantt"/>
        <field name="act_window_id" ref="window_actions.action_row_unordered"/>
    </record>

    <record id="action_row_demo_back" model="ir.actions.act_window">
        <field name="name">action_row_demo_back</field>
        <field name="res_model">window.plain</field>
        <field name="view_mode">list</field>
    </record>

    <record id="row_demo_back" model="ir.actions.act_window.view">
        <field name="view_mode">gantt</field>
        <field name="view_id" ref="window_actions.view_shown_gantt"/>
        <field name="act_window_id" ref="action_row_demo_back"/>
    </record>

    <record id="action_row_demo_back_taker" model="ir.actions.act_window">
        <field name="name">action_row_demo_back_taker</field>
        <field name="res_model">window.plain</field>
        <field name="view_mode">list</field>
        <field name="view_ids" eval="[(4, ref('row_demo_back'))]"/>
    </record>

    <record id="action_row_demo_cleared" model="ir.actions.act_window">
        <field name="name">action_row_demo_cleared</field>
        <field name="res_model">window.plain</field>
        <field name="view_mode">gantt</field>
    </record>

    <record id="row_demo_cleared" model="ir.actions.act_window.view">
        <field name="view_mode">gantt</field>
        <field name="view_id" ref="window_actions.view_shown_gantt"/>
        <field name="act_window_id" ref="action_row_demo_cleared"/>
    </record>
</odoo>
