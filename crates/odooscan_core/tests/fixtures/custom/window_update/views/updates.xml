<odoo>
    <record id="window_actions.action_generated" model="ir.actions.act_window">
        <field name="view_mode">list,form,gantt</field>
    </record>

    <record id="window_actions.action_no_date" model="ir.actions.act_window">
        <field name="view_mode">list</field>
    </record>

    <record id="window_actions.action_eval_model" model="ir.actions.act_window">
        <field name="view_mode">gantt</field>
    </record>

    <record id="window_ghost.action_gone" model="ir.actions.act_window">
        <field name="view_mode">gantt</field>
    </record>

    <record id="action_model_replaced" model="ir.actions.act_window">
        <field name="res_model" eval="'window.plain'"/>
    </record>

    <record id="action_mode_replaced" model="ir.actions.act_window">
        <field name="name">action_mode_replaced</field>
        <field name="res_model">window.plain</field>
        <field name="view_mode">gantt</field>
    </record>

    <record id="action_mode_grown" model="ir.actions.act_window">
        <field name="name">action_mode_grown</field>
        <field name="res_model">window.plain</field>
        <field name="view_mode">list</field>
    </record>

    <record id="action_mode_hidden" model="ir.actions.act_window">
        <field name="name">action_mode_hidden</field>
        <field name="res_model">window.plain</field>
        <field name="view_mode">gantt</field>
    </record>

    <record id="action_moved" model="ir.actions.act_window">
        <field name="name">action_moved</field>
        <field name="res_model">window.plain</field>
    </record>

    <record id="action_own" model="ir.actions.act_window">
        <field name="name">action_own</field>
        <field name="res_model">window.plain</field>
    </record>
</odoo>
