<odoo>
    <record id="action_late" model="ir.actions.act_window">
        <field name="name">Late</field>
    </record>

    <record id="view_order_tree_lines" model="ir.ui.view">
        <field name="inherit_id" ref="view_order_tree"/>
        <field name="arch" type="xml">
            <list position="inside">
                <field name="amount"/>
            </list>
        </field>
    </record>

    <record id="view_project_late" model="ir.ui.view">
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <form/>
        </field>
    </record>

    <record id="partner_late" model="res.partner">
        <field name="parent_id" ref="mail.no_such_id"/>
        <field name="child_ids" eval="[(4, ref('encoded_lost.no_such_id'))]"/>
    </record>
</odoo>
