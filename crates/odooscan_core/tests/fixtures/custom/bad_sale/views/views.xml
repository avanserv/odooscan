<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_tree" model="ir.ui.view">
        <field name="model">bad.order</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" attrs="{'invisible': [('total', '=', 0)]}"/>
                <field name="nmae"/>
                <field name="line_ids">
                    <list>
                        <field name="amount"/>
                        <field name="amonut"/>
                    </list>
                </field>
                <button name="%(action_late)d" type="action" groups="base.group_user,mail.mail_menu"/>
            </tree>
        </field>
    </record>

    <record id="view_partner_form" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="country_id"/>
                <field name="vat"/>
            </field>
        </field>
    </record>

    <record id="partner_demo" model="res.partner">
        <field name="name">Demo</field>
        <field name="name@fr">Démo</field>
        <field name="email">demo@example.com</field>
    </record>
    <record id="partner_demo" model="res.partner">
        <field name="name">Again</field>
    </record>

    <template id="portal_order">
        <div t-raw="order.note"/>
    </template>

    <record id="action_orders" model="ir.actions.act_window">
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
