<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_tree" model="ir.ui.view">
        <field name="model">bad.order</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" attrs="{'invisible': [('total', '=', 0)]}"/>
                <field name="nmae"/>
                <field name="line_ids">
                    <list>
                        <field name="amount"/>
                        <field name="amonut"/>
                    </list>
                </field>
                <button name="%(action_late)d" type="action" groups="base.group_user,mail.mail_menu"/>
            </tree>
        </field>
    </record>

    <record id="view_partner_form" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="country_id"/>
                <field name="vat"/>
            </field>
        </field>
    </record>

    <record id="partner_demo" model="res.partner">
        <field name="name">Demo</field>
        <field name="name@fr">Démo</field>
        <field name="email">demo@example.com</field>
    </record>
    <record id="partner_demo" model="res.partner">
        <field name="name">Again</field>
    </record>

    <record id="nested_parent" model="res.partner">
        <field name="child_ids">
            <record id="nested_child" model="res.partner"><field name="name">Child</field></record>
        </field>
    </record>

    <asset id="bad_asset" name="Bad asset"/>

    <template id="portal_order">
        <div t-raw="order.note"/>
    </template>

    <record id="action_orders" model="ir.actions.act_window">
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_order_form_lines" model="ir.ui.view">
        <field name="model">bad.order</field>
        <field name="arch" type="xml">
            <form>
                <field name="line_ids">
                    <tree>
                        <field name="amount"/>
                    </tree>
                </field>
            </form>
        </field>
    </record>

    <record id="view_order_kanban" model="ir.ui.view">
        <field name="model">bad.order</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="kanban-box">
                        <div><field name="name"/></div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_order_form_chatter" model="ir.ui.view">
        <field name="model">bad.order</field>
        <field name="arch" type="xml">
            <form>
                <field name="name"/>
                <div class="oe_chatter"/>
            </form>
        </field>
    </record>

    <record id="view_order_form_chatter_ported" model="ir.ui.view">
        <field name="model">bad.order</field>
        <field name="inherit_id" ref="view_order_form_chatter"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_chatter')]" position="replace">
                <chatter/>
            </xpath>
        </field>
    </record>

    <record id="action_orders_list_row" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="action_orders"/>
        <field name="view_mode">tree</field>
    </record>
</odoo>
