<odoo>
    <record id="bulletin_banner" model="ir.ui.view">
        <field name="inherit_id" ref="web_bulletin.bulletin"/>
        <field name="arch" type="xml">
            <xpath expr="//body" position="inside">
                <div class="banner"/>
            </xpath>
        </field>
    </record>

    <record id="stamp_form" model="ir.ui.view">
        <field name="name">legacy.stamp.form</field>
        <field name="model">legacy.stamp</field>
        <field name="arch" type="xml">
            <form>
                <button type="object" name="action_stmap"/>
                <button type="object" name="_stamp"/>
            </form>
        </field>
    </record>

    <record id="action_stamp_activity" model="ir.actions.act_window">
        <field name="name">action_stamp_activity</field>
        <field name="res_model">legacy.stamp</field>
        <field name="view_mode">tree,activity</field>
    </record>
</odoo>
