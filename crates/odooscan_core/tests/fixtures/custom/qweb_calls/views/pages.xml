<odoo>
    <template id="home">
        <t t-call="web.layout">
            <t t-call="web.layot"/>
            <t t-call="local"/>
            <t t-call="qweb_outside.page"/>
            <t t-call="ghost_addon.page"/>
            <t t-call="qweb_calls.alias"/>
            <t t-call="qweb_calls.record_alias"/>
            <t t-call="{{ template_name }}"/>
            <t t-call="qweb_calls.#{suffix}"/>
            <t t-call="33"/>
            <t t-call="a/templates/b.xml"/>
        </t>
    </template>

    <template id="keyed" key="qweb_calls.alias">
        <div/>
    </template>

    <template id="home_layout" inherit_id="home">
        <xpath expr="//t" position="attributes">
            <attribute name="t-call">web.layot_extended</attribute>
        </xpath>
    </template>

    <record id="keyed_record" model="ir.ui.view">
        <field name="name">keyed.record</field>
        <field name="type">qweb</field>
        <field name="key">qweb_calls.record_alias</field>
        <field name="arch" type="xml">
            <t t-name="keyed_record">
                <t t-call="web.layot_record"/>
            </t>
        </field>
    </record>

    <record id="home_appended" model="ir.ui.view">
        <field name="name">home.appended</field>
        <field name="inherit_id" ref="home"/>
        <field name="arch" type="xml">
            <xpath expr="//t" position="inside">
                <t t-call="web.layot_appended"/>
            </xpath>
        </field>
    </record>

    <record id="partner_kanban" model="ir.ui.view">
        <field name="name">partner.kanban</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <t t-call="kanban_block"/>
                    </t>
                    <t t-name="kanban_block">
                        <div/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <template id="partner_kanban_card" inherit_id="partner_kanban">
        <xpath expr="//t" position="inside">
            <t t-call="kanban_extra"/>
        </xpath>
    </template>

    <template t-name="by_name">
        <div/>
    </template>

    <template t-name="qweb_calls.by_full_name">
        <div/>
    </template>

    <template id="by_id" t-name="not_a_name">
        <div/>
    </template>

    <template t-name="named_extension" inherit_id="by_id">
        <xpath expr="//div" position="inside">
            <div name="added_by_name"/>
        </xpath>
    </template>

    <template id="extends_named" inherit_id="by_id">
        <xpath expr="//div[@name='added_by_name']" position="inside">
            <span/>
        </xpath>
    </template>

    <template id="extends_by_name" inherit_id="by_name">
        <xpath expr="//div" position="inside">
            <span/>
        </xpath>
    </template>

    <template id="names">
        <t t-call="qweb_calls.by_name"/>
        <t t-call="qweb_calls.by_full_name"/>
        <t t-call="qweb_calls.by_id"/>
        <t t-call="qweb_calls.absent_name"/>
        <t t-call="by_name"/>
        <t t-call="qweb_calls.not_a_name"/>
        <t t-call="not_a_name"/>
    </template>

    <template id="root_call_dropped" inherit_id="home" t-call="web.layot_dropped">
        <xpath expr="//t" position="inside">
            <t t-call="web.layot_inside_extension"/>
        </xpath>
    </template>

    <template id="primary_root_call_dropped" inherit_id="home" primary="True" t-call="web.layot_primary"/>

    <template id="empty_parent" inherit_id=""/>

    <template id="loaded_files">
        <t t-call="qweb_calls.aside_page"/>
        <t t-call="qweb_calls.aside_key"/>
        <t t-call="qweb_calls.test_page"/>
        <t t-call="qweb_calls.migration_page"/>
        <t t-call="qweb_outside.aside_page"/>
        <t t-call="qweb_calls.demo_page"/>
        <t t-call="qweb_calls.code_page"/>
    </template>

    <template id="extends_aside" inherit_id="home">
        <xpath expr="//div[@name='aside_block']" position="after">
            <span/>
        </xpath>
    </template>

    <template id="unread_key">
        <t t-call="qweb_calls.other_page"/>
    </template>

    <template id="stale_call" inherit_id="home">
        <t t-call="web.layot_stale" position="replace">
            <t t-call="web.layot_replacement"/>
        </t>
    </template>

    <template id="stale_call_xpath" inherit_id="home">
        <xpath expr="//t[@t-call='web.layot_stale_xpath']" position="inside">
            <span/>
        </xpath>
    </template>

    <template id="moved_call" inherit_id="home">
        <xpath expr="//t" position="inside">
            <t t-call="web.layot_moved" position="move"/>
        </xpath>
    </template>

    <record id="stale_call_record" model="ir.ui.view">
        <field name="name">stale.call.record</field>
        <field name="arch" type="xml">
            <data>
                <t t-call="web.layot_stale_record" position="replace"/>
            </data>
        </field>
        <field name="inherit_id" ref="home"/>
    </record>

    <template id="positioned_content" inherit_id="home">
        <xpath expr="//t" position="inside">
            <t t-call="web.layot_positioned" position="'top'"/>
        </xpath>
    </template>

    <template id="positioned_call">
        <t t-call="web.layot_positioned_plain" position="'top'"/>
    </template>

    <!-- home calls web.layot itself, so these locate it, and read as calls they would report. -->
    <template id="located_call" inherit_id="home">
        <t t-call="web.layot" position="attributes">
            <attribute name="t-call">web.layot_set</attribute>
        </t>
    </template>

    <template id="located_call_bare" inherit_id="home">
        <t t-call="web.layot"/>
    </template>

    <template id="root_call" t-call="web.layout"/>

    <template id="root_call_located" inherit_id="root_call">
        <t t-call="web.layout" position="inside">
            <span/>
        </t>
    </template>

    <!-- Each record has no parent, so its root is an element the template after it finds. -->
    <record id="no_parent_eval" model="ir.ui.view">
        <field name="name">no.parent.eval</field>
        <field name="inherit_id" eval="False"/>
        <field name="arch" type="xml">
            <t t-call="web.layout"/>
        </field>
    </record>

    <template id="no_parent_eval_located" inherit_id="no_parent_eval">
        <t t-call="web.layout" position="inside">
            <span/>
        </t>
    </template>

    <record id="no_parent_ref" model="ir.ui.view">
        <field name="name">no.parent.ref</field>
        <field name="inherit_id" ref=""/>
        <field name="arch" type="xml">
            <t t-call="web.layout"/>
        </field>
    </record>

    <template id="no_parent_ref_located" inherit_id="no_parent_ref">
        <t t-call="web.layout" position="inside">
            <span/>
        </t>
    </template>

    <record id="no_parent_bare" model="ir.ui.view">
        <field name="name">no.parent.bare</field>
        <field name="inherit_id"/>
        <field name="arch" type="xml">
            <t t-call="web.layout"/>
        </field>
    </record>

    <template id="no_parent_bare_located" inherit_id="no_parent_bare">
        <t t-call="web.layout" position="inside">
            <span/>
        </t>
    </template>
</odoo>
