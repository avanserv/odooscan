<odoo>
    <record id="user_form" model="ir.ui.view">
        <field name="name">res.users.form</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <form>
                <button type="object" name="action_contcat"/>
            </form>
        </field>
    </record>

    <function model="res.users" name="_run_misspelled"/>
    <function model="res.users" name="action_contact"/>
    <function model="res.partner" name="action_contact"/>
    <function model="button.copied" name="action_contact"/>

    <record id="cron_user" model="ir.cron">
        <field name="name">cron_user</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="code">model.action_contcat()</field>
    </record>
</odoo>
