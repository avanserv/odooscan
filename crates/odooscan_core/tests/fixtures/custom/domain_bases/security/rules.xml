<odoo>
    <record id="rule_xml_hidden" model="ir.rule">
        <field name="name">Hidden parent</field>
        <field name="model_id" ref="model_domain_hidden"/>
        <field name="domain_force">[('stamp', '=', 'a')]</field>
    </record>
    <record id="rule_xml_whole" model="ir.rule">
        <field name="name">Every parent read</field>
        <field name="model_id" ref="model_domain_whole"/>
        <field name="domain_force">[('no_xml_rule', '=', 'a')]</field>
    </record>
</odoo>
