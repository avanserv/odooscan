<odoo>
    <template id="assets_backend" inherit_id="web.assets_backend">
        <xpath expr="." position="inside">
            <script type="text/javascript" src="/legacy_require14/static/src/js/counter.js"/>
            <script type="text/javascript" src="/legacy_require14/static/src/js/dropped.js"/>
            <script type="text/javascript" src="/legacy_require14/static/src/js/kept.js"/>
            <script type="text/javascript" src="/legacy_require14/static/src/js/module.js"/>
            <script type="text/javascript" src="/legacy_require14/static/src/js/restored.js"/>
            <script type="text/javascript" src="/legacy_require14/static/src/js/rpc.js"/>
        </xpath>
    </template>

    <template id="assets_backend_trimmed" inherit_id="legacy_require14.assets_backend">
        <xpath expr="//script[@src='/legacy_require14/static/src/js/dropped.js']" position="replace"/>
        <xpath expr="//script[@src='/legacy_require14/static/src/js/kept.js']" position="replace">
            <script type="text/javascript" src="/legacy_require14/static/src/js/kept.js"/>
        </xpath>
        <xpath expr="//script[@src='/legacy_require14/static/src/js/restored.js']" position="replace">
            <t t-call="legacy_require14.restored_scripts"/>
        </xpath>
    </template>

    <template id="restored_scripts">
        <script type="text/javascript" src="/legacy_require14/static/src/js/restored.js"/>
    </template>
</odoo>
