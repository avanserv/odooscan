<odoo>
    <template id="assets_backend" inherit_id="web.assets_backend">
        <xpath expr="." position="inside">
            <script type="text/javascript" src="/legacy_require14/static/src/js/counter.js"/>
            <script type="text/javascript" src="/legacy_require14/static/src/js/dropped.js"/>
            <script type="text/javascript" src="/legacy_require14/static/src/js/module.js"/>
        </xpath>
    </template>

    <template id="assets_backend_trimmed" inherit_id="legacy_require14.assets_backend">
        <xpath expr="//script[@src='/legacy_require14/static/src/js/dropped.js']" position="replace"/>
    </template>
</odoo>
